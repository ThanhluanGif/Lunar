# ============================================
# Lunar.dev — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
#   cp .env.example .env
#
# WARNING: NEVER commit the .env file to Git!
# ============================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=development

# --- JWT Authentication ---
# Generate a secure random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your_jwt_secret_here

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/lunar_db

# --- Supabase (Frontend - Vite, optional) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (Server-side, optional) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- GitHub OAuth & Repository Sync ---
# Create an OAuth App with callback URL:
# http://localhost:5000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
# Safe default syncs public repositories. Classic OAuth "repo" grants broad
# read/write private-repository access; prefer a GitHub App for private repos.
GITHUB_OAUTH_SCOPES=read:user user:email

# --- Server-side AI providers (never expose these as VITE_* variables) ---
# Virtual assistant: one Gateway key can route across the current models below.
# Create a key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.6-flash
AI_GATEWAY_FALLBACK_MODELS=openai/gpt-5.6-terra,anthropic/claude-sonnet-5

# Direct providers are still used by the code-review endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_MAX_CODE_CHARACTERS=120000
DEEP_SCAN_MAX_FILES=250
DEEP_SCAN_MAX_FILE_BYTES=512000
DEEP_SCAN_MAX_TOTAL_BYTES=5000000
DEEP_SCAN_CONCURRENCY=5

# --- Per-user Gmail OAuth (server-only) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/notifications/gmail/oauth/callback
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_DRY_RUN=false

# --- Transactional account email (verification + password reset) ---
# This is a Lunar system mailbox, separate from each user's Gmail alert OAuth.
# Example: smtps://username:app-password@smtp.gmail.com
AUTH_EMAIL_SMTP_URL=
AUTH_EMAIL_FROM=Lunar Security <no-reply@example.com>
AUTH_EMAIL_BASE_URL=http://localhost:5000
AUTH_EMAIL_DRY_RUN=false

# --- Payment gateway webhook ---
# Gateway signs the exact raw JSON body with HMAC-SHA256.
PAYMENT_WEBHOOK_SECRET=

# --- Docker Compose (Mac/local defaults; override all secrets in production) ---
LUNAR_APP_PORT=5050
LUNAR_POSTGRES_PORT=5433
LUNAR_JWT_SECRET=replace_with_at_least_32_random_characters
LUNAR_POSTGRES_USER=lunar_admin
LUNAR_POSTGRES_PASSWORD=replace_with_a_strong_database_password
LUNAR_POSTGRES_DB=lunar_db
LUNAR_CORS_ORIGINS=http://localhost:5050
LUNAR_PAYMENT_WEBHOOK_SECRET=replace_with_a_strong_random_secret
LUNAR_ADMIN_BOOTSTRAP_TOKEN=replace_with_a_one_time_random_bootstrap_token
LUNAR_COOKIE_SECURE=false
LUNAR_GITHUB_CLIENT_ID=
LUNAR_GITHUB_CLIENT_SECRET=
LUNAR_GITHUB_OAUTH_CALLBACK_URL=http://localhost:5050/api/v1/auth/github/callback
LUNAR_GITHUB_TOKEN_ENCRYPTION_KEY=
LUNAR_GITHUB_OAUTH_SCOPES=read:user user:email
LUNAR_GEMINI_API_KEY=
LUNAR_GEMINI_MODEL=gemini-2.5-flash
LUNAR_OPENAI_API_KEY=
LUNAR_OPENAI_MODEL=gpt-4o-mini
LUNAR_ANTHROPIC_API_KEY=
LUNAR_ANTHROPIC_MODEL=claude-sonnet-4-5
LUNAR_AI_GATEWAY_API_KEY=
LUNAR_AI_GATEWAY_MODEL=google/gemini-3.6-flash
LUNAR_AI_GATEWAY_FALLBACK_MODELS=openai/gpt-5.6-terra,anthropic/claude-sonnet-5
LUNAR_GMAIL_CLIENT_ID=
LUNAR_GMAIL_CLIENT_SECRET=
LUNAR_GMAIL_OAUTH_CALLBACK_URL=http://localhost:5050/api/v1/notifications/gmail/oauth/callback
LUNAR_GMAIL_TOKEN_ENCRYPTION_KEY=
LUNAR_GMAIL_DRY_RUN=false
LUNAR_AUTH_EMAIL_SMTP_URL=
LUNAR_AUTH_EMAIL_FROM=Lunar Security <no-reply@example.com>
LUNAR_AUTH_EMAIL_BASE_URL=http://localhost:5050
LUNAR_AUTH_EMAIL_DRY_RUN=false

# Test-only switch. Never enable this in production.
ENABLE_PAYMENT_MOCK=false
LUNAR_GITHUB_WEBHOOK_SECRET=
LUNAR_PAYMENT_BANK_ID=
LUNAR_PAYMENT_ACCOUNT_NO=
LUNAR_PAYMENT_ACCOUNT_NAME=

# --- Supabase (Next.js compatibility, optional) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# --- PostgreSQL Direct Connection (optional) ---
# SUPABASE_POSTGRES_DATABASE=postgres
# SUPABASE_POSTGRES_HOST=db.your-project-ref.supabase.co
# SUPABASE_POSTGRES_PASSWORD=your_postgres_password_here
# SUPABASE_POSTGRES_USER=postgres
# SUPABASE_POSTGRES_PRISMA_URL=postgres://postgres.your-project-ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# SUPABASE_POSTGRES_URL=postgres://postgres.your-project-ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# SUPABASE_POSTGRES_URL_NON_POOLING=postgres://postgres.your-project-ref:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- AI / Gemini API ---
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
