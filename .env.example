# Production Environment Configuration Template
PORT=5000
NODE_ENV=production

# Official JWT Secret Key for Token Signing
JWT_SECRET=replace_with_at_least_32_random_characters

# PostgreSQL Production Database Connection String
DATABASE_URL=postgresql://lunar_user:lunar_password_secure@localhost:5432/lunar_db

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Required by /api/v1/payment/mock-webhook in production
PAYMENT_WEBHOOK_SECRET=replace_with_a_strong_random_secret

# Docker Compose deployment variables
LUNAR_JWT_SECRET=replace_with_at_least_32_random_characters
LUNAR_POSTGRES_USER=lunar_admin
LUNAR_POSTGRES_PASSWORD=replace_with_a_strong_database_password
LUNAR_POSTGRES_DB=lunar_db
LUNAR_CORS_ORIGINS=https://your-production-domain.example
LUNAR_PAYMENT_WEBHOOK_SECRET=replace_with_a_strong_random_secret
